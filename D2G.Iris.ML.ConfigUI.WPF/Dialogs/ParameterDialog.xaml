<Window x:Class="D2G.Iris.ML.ConfigUI.WPF.Dialogs.ParameterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Algorithm Parameter"
        Height="250" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Parameter Name -->
        <Label Grid.Row="0" Grid.Column="0" Content="Parameter Name:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" 
                 Text="{Binding ParameterName, UpdateSourceTrigger=PropertyChanged}" 
                 VerticalAlignment="Center" Height="25"/>

        <!-- Parameter Value -->
        <Label Grid.Row="2" Grid.Column="0" Content="Parameter Value:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" 
                 Text="{Binding ParameterValueString, UpdateSourceTrigger=PropertyChanged}" 
                 VerticalAlignment="Center" Height="25"/>

        <!-- Value Hint -->
        <Label Grid.Row="4" Grid.Column="0" Content="Hint:" VerticalAlignment="Top"/>
        <TextBlock Grid.Row="4" Grid.Column="1" 
                   Text="Enter integer, decimal, boolean (true/false), or text value"
                   TextWrapping="Wrap" 
                   Foreground="Gray"
                   VerticalAlignment="Top"/>

        <!-- Example -->
        <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" 
                   Text="Examples: 20 (integer), 0.1 (decimal), true (boolean), 'text' (string)"
                   TextWrapping="Wrap" 
                   Foreground="DarkBlue"
                   FontStyle="Italic"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" 
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">

            <Button Content="OK" 
                    Click="OkButton_Click"
                    IsDefault="True"
                    Width="80" Height="30" Margin="0,0,10,0"/>

            <Button Content="Cancel" 
                    Click="CancelButton_Click"
                    IsCancel="True"
                    Width="80" Height="30"/>
        </StackPanel>
    </Grid>
</Window>