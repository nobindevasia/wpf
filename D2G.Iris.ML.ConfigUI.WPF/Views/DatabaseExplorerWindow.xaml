<Window x:Class="D2G.Iris.ML.ConfigUI.WPF.Views.DatabaseExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d" 
        Title="Database Explorer" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="600" MinHeight="400">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Connection Info and Refresh Button -->
        <Border Grid.Row="0" Background="LightBlue" Padding="10" CornerRadius="5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Server: " FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Server}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <TextBlock Text="Database: " FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Database}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <Button Content="Refresh Tables" 
                        Command="{Binding LoadTablesCommand}"
                        Width="100" Height="25" 
                        Background="White"/>
                <TextBlock Text="Loading..." 
                           Visibility="{Binding IsLoadingTables, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Margin="10,0,0,0" 
                           VerticalAlignment="Center"
                           FontStyle="Italic"/>
            </StackPanel>
        </Border>

        <!-- Tables List -->
        <DataGrid Grid.Row="2" 
                  ItemsSource="{Binding Tables}"
                  SelectedItem="{Binding SelectedTable}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="LightGray"
                  MouseDoubleClick="DataGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Schema" 
                                  Binding="{Binding SchemaName}" 
                                  Width="120"/>
                <DataGridTextColumn Header="Table Name" 
                                  Binding="{Binding TableName}" 
                                  Width="200"/>
                <DataGridTextColumn Header="Type" 
                                  Binding="{Binding TableType}" 
                                  Width="100"/>
                <DataGridTextColumn Header="Full Name" 
                                  Binding="{Binding FullName}" 
                                  Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Selected Table Info -->
        <Border Grid.Row="4" Background="LightGreen" Padding="10" CornerRadius="5"
                Visibility="{Binding SelectedTable, Converter={StaticResource NotNullToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Selected Table: " FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SelectedTable.FullName}" 
                           FontWeight="Bold" 
                           Foreground="DarkBlue"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Select Table" 
                    Command="{Binding SelectTableCommand}"
                    IsEnabled="{Binding SelectedTable, Converter={StaticResource NotNullToBooleanConverter}}"
                    Width="100" Height="30"
                    Margin="0,0,10,0"
                    Background="LightGreen"/>
            <Button Content="Cancel" 
                    Click="Cancel_Click"
                    Width="80" Height="30"
                    Background="LightCoral"/>
        </StackPanel>
    </Grid>
</Window>