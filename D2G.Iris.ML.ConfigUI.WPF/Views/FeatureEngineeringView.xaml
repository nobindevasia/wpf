<UserControl x:Class="D2G.Iris.ML.ConfigUI.WPF.Views.FeatureEngineeringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:D2G.Iris.ML.ConfigUI.WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="600">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:StringToDecimalConverter x:Key="StringToDecimalConverter"/>
    </UserControl.Resources>

    <GroupBox Header="Feature Engineering Settings" Margin="10">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Method -->
            <Label Grid.Row="0" Grid.Column="0" Content="Method:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="0" Grid.Column="1" 
                      ItemsSource="{Binding AvailableMethods}"
                      SelectedItem="{Binding SelectedMethod}"
                      VerticalAlignment="Center" Height="25" Width="200" HorizontalAlignment="Left"/>

            <!-- Execution Order -->
            <Label Grid.Row="2" Grid.Column="0" Content="Execution Order:" VerticalAlignment="Center"
                   IsEnabled="{Binding IsMethodSelected}"/>
            <TextBox Grid.Row="2" Grid.Column="1" 
                     Text="{Binding ExecutionOrder, UpdateSourceTrigger=PropertyChanged}" 
                     VerticalAlignment="Center" Height="25" Width="80" HorizontalAlignment="Left"
                     IsEnabled="{Binding IsMethodSelected}"/>

            <!-- Number of Components (PCA only) -->
            <Label Grid.Row="4" Grid.Column="0" Content="Number of Components:" VerticalAlignment="Center"
                   Visibility="{Binding IsPcaSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBox Grid.Row="4" Grid.Column="1" 
                     Text="{Binding NumberOfComponents, UpdateSourceTrigger=PropertyChanged}" 
                     VerticalAlignment="Center" Height="25" Width="80" HorizontalAlignment="Left"
                     Visibility="{Binding IsPcaSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- Max Features (Correlation only) -->
            <Label Grid.Row="6" Grid.Column="0" Content="Max Features:" VerticalAlignment="Center"
                   Visibility="{Binding IsCorrelationSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBox Grid.Row="6" Grid.Column="1" 
                     Text="{Binding MaxFeatures, UpdateSourceTrigger=PropertyChanged}" 
                     VerticalAlignment="Center" Height="25" Width="80" HorizontalAlignment="Left"
                     Visibility="{Binding IsCorrelationSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- Multicollinearity Threshold (Correlation only) -->
            <Label Grid.Row="8" Grid.Column="0" Content="Multicollinearity Threshold:" VerticalAlignment="Center"
                   Visibility="{Binding IsCorrelationSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBox Grid.Row="8" Grid.Column="1" 
                     Text="{Binding MulticollinearityThreshold, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource StringToDecimalConverter}}" 
                     VerticalAlignment="Center" Height="25" Width="80" HorizontalAlignment="Left"
                     Visibility="{Binding IsCorrelationSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- Description -->
            <TextBlock Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" 
                       Text="{Binding Description}" 
                       TextWrapping="Wrap" 
                       Foreground="DarkBlue"
                       Margin="0,10,0,0"/>
        </Grid>
    </GroupBox>
</UserControl>