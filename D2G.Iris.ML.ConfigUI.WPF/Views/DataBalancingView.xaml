<UserControl x:Class="D2G.Iris.ML.ConfigUI.WPF.Views.DataBalancingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:D2G.Iris.ML.ConfigUI.WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="600">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:StringToDecimalConverter x:Key="StringToDecimalConverter"/>
    </UserControl.Resources>

    <GroupBox Header="Data Balancing Settings" Margin="10">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            
            <Label Grid.Row="0" Grid.Column="0" Content="Method:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="0" Grid.Column="1" 
                      ItemsSource="{Binding AvailableMethods}"
                      SelectedItem="{Binding SelectedMethod}"
                      VerticalAlignment="Center" Height="25" Width="200" HorizontalAlignment="Left"/>

            
            <Label Grid.Row="2" Grid.Column="0" Content="Execution Order:" VerticalAlignment="Center"
                   IsEnabled="{Binding IsSmoteSelected}"/>
            <TextBox Grid.Row="2" Grid.Column="1" 
                     Text="{Binding ExecutionOrder, UpdateSourceTrigger=PropertyChanged}" 
                     VerticalAlignment="Center" Height="25" Width="80" HorizontalAlignment="Left"
                     IsEnabled="{Binding IsSmoteSelected}"/>

            
            <Label Grid.Row="4" Grid.Column="0" Content="K Neighbors:" VerticalAlignment="Center"
                   IsEnabled="{Binding IsSmoteSelected}"/>
            <TextBox Grid.Row="4" Grid.Column="1" 
                     Text="{Binding KNeighbors, UpdateSourceTrigger=PropertyChanged}" 
                     VerticalAlignment="Center" Height="25" Width="80" HorizontalAlignment="Left"
                     IsEnabled="{Binding IsSmoteSelected}"/>

            
            <Label Grid.Row="6" Grid.Column="0" Content="Undersampling Ratio:" VerticalAlignment="Center"
                   IsEnabled="{Binding IsSmoteSelected}"/>
            <TextBox Grid.Row="6" Grid.Column="1" 
                     Text="{Binding UndersamplingRatio, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource StringToDecimalConverter}}" 
                     VerticalAlignment="Center" Height="25" Width="80" HorizontalAlignment="Left"
                     IsEnabled="{Binding IsSmoteSelected}"/>

            
            <Label Grid.Row="8" Grid.Column="0" Content="Minority to Majority Ratio:" VerticalAlignment="Center"
                   IsEnabled="{Binding IsSmoteSelected}"/>
            <TextBox Grid.Row="8" Grid.Column="1" 
                     Text="{Binding MinorityToMajorityRatio, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource StringToDecimalConverter}}" 
                     VerticalAlignment="Center" Height="25" Width="80" HorizontalAlignment="Left"
                     IsEnabled="{Binding IsSmoteSelected}"/>

            
            <TextBlock Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" 
                       Text="{Binding Description}" 
                       TextWrapping="Wrap" 
                       Foreground="DarkBlue"
                       Margin="0,10,0,0"/>
        </Grid>
    </GroupBox>
</UserControl>