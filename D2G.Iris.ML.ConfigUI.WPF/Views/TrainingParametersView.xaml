<UserControl x:Class="D2G.Iris.ML.ConfigUI.WPF.Views.TrainingParametersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:D2G.Iris.ML.ConfigUI.WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="600">

    <UserControl.Resources>
        <converters:StringToDecimalConverter x:Key="StringToDecimalConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <GroupBox Header="Training Parameters" Margin="10">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <!-- Model Configuration -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>

                    <!-- Training Mode Selection -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>

                    <!-- Description -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>

                    <!-- Test Fraction (Traditional only) -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>

                    <!-- Traditional Training Section -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>

                    <!-- AutoML Section -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Model Type -->
                <Label Grid.Row="0" Grid.Column="0" Content="Model Type:" VerticalAlignment="Center" FontWeight="Bold"/>
                <ComboBox Grid.Row="0" Grid.Column="1" 
                          ItemsSource="{Binding AvailableModelTypes}"
                          SelectedItem="{Binding ModelType}"
                          VerticalAlignment="Center" Height="25"/>

                <!-- Target Field -->
                <Label Grid.Row="2" Grid.Column="0" Content="Target Field:" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBox Grid.Row="2" Grid.Column="1" 
                         Text="{Binding TargetField, UpdateSourceTrigger=PropertyChanged}" 
                         VerticalAlignment="Center" Height="25"/>

                <!-- Training Mode Selection -->
                <Label Grid.Row="4" Grid.Column="0" Content="Training Mode:" VerticalAlignment="Center" FontWeight="Bold"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                    <RadioButton Content="Traditional Training" 
                                 IsChecked="{Binding UseTraditionalTraining}" 
                                 GroupName="TrainingMode"
                                 VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <RadioButton Content="AutoML" 
                                 IsChecked="{Binding UseAutoML}" 
                                 GroupName="TrainingMode"
                                 VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Description -->
                <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" 
                           Text="{Binding TrainingModeDescription}" 
                           TextWrapping="Wrap" 
                           Foreground="DarkBlue"
                           FontStyle="Italic"
                           Margin="0,5"/>

                <!-- Test Fraction (Only for Traditional Training) -->
                <Label Grid.Row="8" Grid.Column="0" Content="Test Fraction:" VerticalAlignment="Center"
                       Visibility="{Binding UseTraditionalTraining, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBox Grid.Row="8" Grid.Column="1" 
                         Text="{Binding TestFraction, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource StringToDecimalConverter}}" 
                         VerticalAlignment="Center" Height="25" Width="120" HorizontalAlignment="Left"
                         Visibility="{Binding UseTraditionalTraining, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Traditional Training Section -->
                <GroupBox Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" 
                          Header="Traditional Training Settings"
                          Visibility="{Binding UseTraditionalTraining, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Margin="0,5">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Algorithm -->
                        <Label Grid.Row="0" Grid.Column="0" Content="Algorithm:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" 
                                  ItemsSource="{Binding AvailableAlgorithms}"
                                  SelectedItem="{Binding SelectedAlgorithm}"
                                  VerticalAlignment="Center" Height="25"
                                  ToolTip="{Binding AlgorithmTooltip}"/>

                        <!-- Algorithm Parameters Label -->
                        <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="Algorithm Parameters:" FontWeight="Bold"/>

                        <!-- Parameters ListView -->
                        <ListView Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                  ItemsSource="{Binding Parameters}"
                                  SelectedItem="{Binding SelectedParameter}"
                                  SelectionMode="Single"
                                  MinHeight="150">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Parameter Name" Width="200" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="Value" Width="200" DisplayMemberBinding="{Binding ValueString}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- Button Panel -->
                        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" 
                                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">

                            <Button Content="Add Parameter" 
                                    Command="{Binding AddParameterCommand}"
                                    Width="120" Height="30" Margin="0,0,10,0"/>

                            <Button Content="Remove" 
                                    Command="{Binding RemoveParameterCommand}"
                                    Width="70" Height="30"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- AutoML Section -->
                <GroupBox Grid.Row="18" Grid.Column="0" Grid.ColumnSpan="2" 
                          Header="AutoML Settings"
                          Visibility="{Binding UseAutoML, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Margin="0,5">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Max Experiment Time -->
                        <Label Grid.Row="0" Grid.Column="0" Content="Max Experiment Time:" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Text="{Binding MaxExperimentTimeInSeconds, UpdateSourceTrigger=PropertyChanged}" 
                                     VerticalAlignment="Center" Height="25" Width="80"/>
                            <Label Content="seconds" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>

                        <!-- Optimizing Metric -->
                        <Label Grid.Row="2" Grid.Column="0" Content="Optimizing Metric:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" 
                                  ItemsSource="{Binding AvailableMetrics}"
                                  SelectedItem="{Binding OptimizingMetric}"
                                  VerticalAlignment="Center" Height="25" Width="200" HorizontalAlignment="Left"/>
                    </Grid>
                </GroupBox>
            </Grid>
        </GroupBox>
    </ScrollViewer>
</UserControl>